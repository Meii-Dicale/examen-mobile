{
  "expo": {
    "name": "EventEase",
    "slug": "EventEase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eventease",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7A2E8E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7A2E8E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#1A1020",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "EventEase ajoute les événements auxquels tu participes à ton agenda, avec un rappel."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EventEase utilise ta position pour afficher la distance jusqu'aux événements."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EventEase te laisse choisir des photos pour les partager sur les événements auxquels tu as participé.",
          "cameraPermission": "EventEase utilise l'appareil photo pour ajouter des photos aux événements auxquels tu as participé.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
